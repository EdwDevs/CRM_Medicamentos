{
  "hosting": {
    "public": ".",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**", "index.backup.html", "docs/**", "scripts/**", "src/**"],
    "rewrites": [{"source": "**", "destination": "/index.html"}],
    "headers": [
      {"source": "sw.js", "headers": [{"key": "Cache-Control", "value": "no-cache"}]},
      {"source": "**/*.@(js|css)", "headers": [{"key": "Cache-Control", "value": "max-age=604800"}]},
      {"source": "/", "headers": [{"key": "X-Content-Type-Options", "value": "nosniff"}, {"key": "X-Frame-Options", "value": "D[REDACTED]"}, {"key": "X-XSS-Protection", "value": "1; mode=block"}]}
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
